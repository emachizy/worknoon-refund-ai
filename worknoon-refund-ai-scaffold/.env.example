# Shared/local development defaults
MONGO_URI=mongodb://mongo:27017/refund_ai
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# AI classifier: "mock" (deterministic keyword fallback, no key needed) or "openai".
# AI_PROVIDER=openai with an empty OPENAI_API_KEY is rejected at startup.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Per-request timeout for the AI provider, in milliseconds (1000-60000).
OPENAI_TIMEOUT_MS=15000
VITE_API_URL=http://localhost:4000/api
